{
  "name": "ushabti",
  "version": "0.1.0",
  "description": "CLI tool for automating little tasks of a software engineer",
  "type": "module",
  "bin": {
    "ushabti": "bin/ushabti.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node bin/ushabti.js",
    "test": "node --test",
    "prepublishOnly": "npm test",
    "prepare-release": "node scripts/prepare-release.js"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "ushabti.config.example.toml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "cli",
    "github",
    "jira",
    "confluence",
    "automation"
  ],
  "author": "Petr Nevyhoštěný <petr.nevyhosteny@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pnevyk/ushabti.git"
  },
  "bugs": {
    "url": "https://github.com/pnevyk/ushabti/issues"
  },
  "homepage": "https://github.com/pnevyk/ushabti#readme",
  "packageManager": "pnpm@10.6.5",
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "confluence.js": "^3.0.3",
    "jira.js": "^5.3.1",
    "markdown-it": "^14.2.0",
    "octokit": "^5.0.5",
    "smol-toml": "^1.6.1",
    "yaml": "^2.9.0"
  }
}
